PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/webbuilder?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_EXPIRES_IN=7d

# AI Service Keys
FEATHERLESS_API_KEY=rc_your_featherless_api_key_here
FEATHERLESS_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
XAI_API_KEY=xai-your_xai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub & Vercel One-Click Deploy Credentials
GITHUB_TOKEN=ghp_your_github_personal_access_token
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/deploy/github/callback

VERCEL_API_TOKEN=your_vercel_personal_access_token

CLIENT_URL=http://localhost:5173
