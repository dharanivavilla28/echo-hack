# Root level gitignore

# Node modules
node_modules/
client/node_modules/
server/node_modules/

# Environment secrets — NEVER commit real keys
server/.env
client/.env

# Build output
client/dist/
client/build/

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Logs
*.log
npm-debug.log*

# Temporary
*.tmp
*.temp
